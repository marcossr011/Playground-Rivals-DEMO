{
  "name": "recreo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Recreo — 1000+ juegos para el móvil y para la vida real",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:mobile": "tsc --noEmit && vite build --mode mobile",
    "mobile:sync": "npm run build:mobile && npx cap sync",
    "mobile:assets": "node scripts/mobile-assets.mjs && npx capacitor-assets generate --android --ios",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:ios": "npm run mobile:sync && npx cap open ios",
    "shots:store": "node scripts/store-shots.mjs",
    "start": "tsx server/index.ts",
    "icons": "node scripts/icons.mjs",
    "catalog": "tsx scripts/checkCatalog.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/geolocation": "^8.2.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/outfit": "^5.2.5",
    "leaflet": "^1.9.4",
    "nodemailer": "^7.0.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.6.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/leaflet": "^1.9.17",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.1",
    "concurrently": "^9.1.2",
    "sharp": "^0.34.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0"
  }
}
