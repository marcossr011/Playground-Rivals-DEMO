VITE_SERVER_URL=https://tu-servidor.example

# Gmail: usa una contraseña de aplicación de Google, no la contraseña normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=tu-contraseña-de-aplicación
SMTP_FROM=Recreo <tu-cuenta@gmail.com>

